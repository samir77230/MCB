: 3px 8px;\n    border-radius: 4px;\n    margin-top: 10px;\n  }\n</style>\n\n<div class=\"mcb-det\">\n  <p class=\"mcb-det-titre\">Détails du produit</p>\n  <details>\n    <summary>🧪 Formule & efficacité</summary>\n    <div class=\"mcb-det-body\">\n      <div class=\"mcb-det-row\">\n        <span>🌿</span>\n        <p><strong>Formule active anti-poils et anti-odeurs</strong>Décompose les résidus, les poils incrustés et les bactéries responsables des mauvaises odeurs dans le tambour.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>💧</span>\n        <p><strong>Capsule soluble haute concentration</strong>Se dissout entièrement dans l'eau chaude, sans résidu ni surdosage à gérer.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🐾</span>\n        <p><strong>Pensée pour les foyers avec animaux</strong>Cible spécifiquement les poils et l'humidité qui s'accumulent avec un animal à la maison.</p>\n      </div>\n      <span class=\"mcb-det-tag\">Formule d'origine naturelle</span>\n    </div>\n  </details>\n  <details>\n    <summary>🔄 Utilisation</summary>\n    <div class=\"mcb-det-body\">\n      <div class=\"mcb-det-row\">\n        <span>⚡</span>\n        <p><strong>1 capsule, cycle à vide, machine vide</strong>Placez la capsule dans le tambour, lancez un cycle à 60°C sans linge.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🗓️</span>\n        <p><strong>2 utilisation par mois recommandée</strong>Suffisant pour garder le tambour propre et sans odeur toute l'année.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🏡</span>\n        <p><strong>Compatible tous types de machines</strong>Fonctionne avec les lave-linge hublot et top, toutes marques.</p>\n      </div>\n      <span class=\"mcb-det-tag\">Résultat visible dès le 1er cycle</span>\n    </div>\n  </details>\n  <details>\n    <summary>🧺 Compatibilité & usage</summary>\n    <div class=\"mcb-det-body\">\n      <div class=\"mcb-det-row\">\n        <span>✅</span>\n        <p><strong>Universel — toutes machines à laver</strong>Hublot, top, capacité standard ou grande capacité.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>👃</span>\n        <p><strong>Fini les odeurs persistantes</strong>Élimine les mauvaises odeurs même après plusieurs lavages classiques infructueux.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🧵</span>\n        <p><strong>Préserve votre linge</strong>Un tambour propre évite le redépôt de poils et de résidus sur les vêtements suivants.</p>\n      </div>\n      <span class=\"mcb-det-tag\">Fonctionne avec toutes les machines</span>\n    </div>\n  </details>\n  <details>\n    <summary>📦 Contenu & livraison</summary>\n    <div class=\"mcb-det-body\">\n      <div class=\"mcb-det-row\">\n        <span>📬</span>\n        <p><strong>Contenu de l'emballage</strong>1 boîte de 12 capsules nettoyantes Angira.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🚚</span>\n        <p><strong>Expédition sous 24-48h</strong>Livraison 5 à 7 jours. Email de suivi dès l'expédition.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>♻️</span>\n        <p><strong>Emballage recyclable</strong>Boîte pensée pour limiter les déchets, sans plastique inutile.</p>\n      </div>\n      <div class=\"mcb-det-row\">\n        <span>🔄</span>\n        <p><strong>Satisfait ou Remboursé 30 jours</strong>Remboursement intégral, sans question, sans condition.</p>\n      </div>\n      <span class=\"mcb-det-tag\">Livraison 5-7 jours · Retour gratuit</span>\n    </div>\n  </details>\n</div>",
